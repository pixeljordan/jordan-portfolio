---
// Stacked case-study previews on the right side of the hero (desktop only)
const previews = [
  { image: "/images/order-management.png", alt: "Order management platform", link: "/case-study/order-management", pos: "top-[4%] left-0 w-[78%] -rotate-6 z-10", delay: "0.5s" },
  { image: "/images/ai-loan-platform.png", alt: "AI-powered loan review platform", link: "/case-study/ai-loan-review", pos: "top-[30%] right-0 w-[80%] rotate-3 z-20", delay: "0.65s" },
  { image: "/images/chatbot-landing-hero.png", alt: "Conversational AI mortgage prequalification", link: "/case-study/ai-chatbot", pos: "top-[52%] left-[10%] w-[44%] -rotate-2 z-30", delay: "0.8s" },
];

const proof = [
  { value: "<6 mo", label: "Fintech platform, concept to production" },
  { value: "+30%", label: "Client adoption after launch" },
  { value: "50+", label: "User interviews and usability sessions" },
];
---
<section class="min-h-screen flex flex-col justify-center px-6 md:px-10 pt-24 pb-16 relative bg-[var(--color-bg)] overflow-hidden">
  <!-- Quiet dot grid behind the work previews, fading out toward the text -->
  <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(rgba(26,26,26,0.14) 1px, transparent 1px); background-size: 24px 24px; mask-image: radial-gradient(ellipse 55% 60% at 75% 50%, #000 0%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 55% 60% at 75% 50%, #000 0%, transparent 75%);"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-8 items-center">
  <div>
    <!-- Title -->
    <h1 class="font-display text-[clamp(4.5rem,13vw,9rem)] lg:text-[clamp(5rem,8.5vw,8.5rem)] font-medium tracking-[-0.025em] leading-[1] mb-8">
      <span class="hero-word" style="animation-delay: 0s">product </span>
      <span class="hero-word" style="animation-delay: 0.15s">designer</span>
    </h1>

    <!-- Description — slightly larger -->
    <p class="text-xl md:text-2xl text-[var(--color-text-secondary)] max-w-xl mb-10 hero-subtitle leading-relaxed">
      I design where the stakes are high and the systems are complex. Fintech, mortgage, AI-native products — built for the humans using them today and the agents navigating them tomorrow.
    </p>

    <!-- Proof strip: credentials and outcomes from the resume -->
    <div class="max-w-xl mb-12 hero-description">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)] mb-4">
        Senior Product Designer · Xpanse, 2024–2026
      </p>
      <dl class="grid grid-cols-3 border-t border-[var(--color-border)] pt-5">
        {proof.map((s, i) => (
          <div class={`flex flex-col-reverse justify-end ${i > 0 ? "pl-5 border-l border-[var(--color-border)]" : "pr-5"}`}>
            <dt class="text-sm text-[var(--color-text-secondary)] leading-snug mt-2">{s.label}</dt>
            <dd class="font-display text-3xl md:text-4xl leading-none">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Actions: projects + chat -->
    <div class="flex flex-wrap items-center gap-x-8 gap-y-5 hero-tags">
      <a href="#projects" class="inline-flex items-center gap-4 no-underline text-[var(--color-text)] font-semibold text-sm uppercase tracking-widest group">
        <span class="w-14 h-14 flex items-center justify-center rounded-full border border-[var(--color-text)] group-hover:bg-[var(--color-text)] group-hover:text-white transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </span>
        View Projects
      </a>

      <button onclick="openChat()" class="inline-flex items-center gap-3 bg-white border border-[var(--color-border)] rounded-full pl-2 pr-5 py-2 shadow-sm cursor-pointer hover:shadow-md hover:border-[var(--color-text-muted)] transition-all duration-300 text-left">
        <span class="relative flex-shrink-0">
          <img src="/images/avatar-face.png" alt="" class="w-10 h-10 rounded-full object-cover" />
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-[var(--color-accent)] border-2 border-white rounded-full status-pulse"></span>
        </span>
        <span class="text-sm font-medium text-[var(--color-text)]">Ask the AI version of me</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-text-muted)]"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </div>
  </div>

  <!-- Stacked work previews -->
  <div class="hidden lg:block relative aspect-[1/1] w-full">
    {previews.map((p) => (
      <a href={p.link} class={`hero-preview absolute ${p.pos}`} style={`animation-delay: ${p.delay}`} aria-label={p.alt}>
        <img src={p.image} alt={p.alt} class="w-full h-auto block rounded-xl border border-[var(--color-border)] bg-white shadow-[0_24px_60px_-20px_rgba(40,20,60,0.35)] transition-transform duration-500 ease-out hover:-translate-y-2 hover:scale-[1.02]" loading="eager" />
      </a>
    ))}
  </div>
  </div>
</section>
